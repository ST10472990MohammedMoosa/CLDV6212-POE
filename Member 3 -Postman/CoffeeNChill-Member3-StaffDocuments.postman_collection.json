{
  "info": {
    "_postman_id": "91cb04cf-6ee1-4b50-a70a-6212a0030001",
    "name": "CoffeeNChill - Member 3 Staff Documents",
    "description": "Part 1 tests for upload, list and download staff-document Functions. Select a valid local PDF in the Valid PDF Upload request before running it.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:7077/api"
    },
    {
      "key": "documentFileName",
      "value": "barista-recipe.pdf"
    }
  ],
  "item": [
    {
      "name": "Staff Documents",
      "item": [
        {
          "name": "Valid PDF Upload",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('Upload metadata is returned', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.fileName).to.be.a('string').and.not.empty;",
                  "  pm.expect(body.sizeInBytes).to.be.above(0);",
                  "  pm.expect(body.contentType).to.eql('application/pdf');",
                  "  pm.collectionVariables.set('documentFileName', body.fileName);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": ""
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/documents/upload",
              "host": ["{{baseUrl}}"],
              "path": ["documents", "upload"]
            }
          }
        },
        {
          "name": "Upload Without File - 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 400 Bad Request', () => pm.response.to.have.status(400));",
                  "pm.test('Structured validation error is returned', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.error).to.eql('VALIDATION_ERROR');",
                  "  pm.expect(body.message).to.be.a('string').and.not.empty;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "description",
                  "value": "No file attached",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/documents/upload",
              "host": ["{{baseUrl}}"],
              "path": ["documents", "upload"]
            }
          }
        },
        {
          "name": "List Staff Documents",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Response is a metadata array', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.be.an('array');",
                  "  if (body.length > 0) {",
                  "    pm.expect(body[0]).to.have.all.keys('fileName', 'sizeInBytes', 'lastModified', 'contentType');",
                  "    pm.collectionVariables.set('documentFileName', body[0].fileName);",
                  "  }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/documents",
              "host": ["{{baseUrl}}"],
              "path": ["documents"]
            }
          }
        },
        {
          "name": "Download Existing PDF",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Content type is PDF', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/pdf'));",
                  "pm.test('Downloaded file is not empty', () => pm.expect(pm.response.responseSize).to.be.above(0));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/documents/download/{{documentFileName}}",
              "host": ["{{baseUrl}}"],
              "path": ["documents", "download", "{{documentFileName}}"]
            }
          }
        },
        {
          "name": "Download Missing PDF - 404",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 404 Not Found', () => pm.response.to.have.status(404));",
                  "pm.test('Structured not-found error is returned', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.error).to.eql('DOCUMENT_NOT_FOUND');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/documents/download/not-found-document.pdf",
              "host": ["{{baseUrl}}"],
              "path": ["documents", "download", "not-found-document.pdf"]
            }
          }
        },
        {
          "name": "Upload Unsupported File Type - 400",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Status is 400 Bad Request', () => pm.response.to.have.status(400));",
                "pm.test('Unsupported file type is rejected', () => {",
                "  const body = pm.response.json();",
                "  pm.expect(body.error).to.eql('VALIDATION_ERROR');",
                "  pm.expect(body.message).to.eql('Only PDF staff documents are permitted.');",
                "});"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [{"key": "file", "type": "file", "src": ""}]
            },
            "url": {
              "raw": "{{baseUrl}}/documents/upload",
              "host": ["{{baseUrl}}"],
              "path": ["documents", "upload"]
            }
          }
        },
        {
          "name": "Upload Duplicate Document - 409",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Status is 409 Conflict', () => pm.response.to.have.status(409));",
                "pm.test('Duplicate error is returned', () => {",
                "  const body = pm.response.json();",
                "  pm.expect(body.error).to.eql('DOCUMENT_ALREADY_EXISTS');",
                "  pm.expect(body.message).to.eql('A document with the same file name already exists.');",
                "});"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [{"key": "file", "type": "file", "src": ""}]
            },
            "url": {
              "raw": "{{baseUrl}}/documents/upload",
              "host": ["{{baseUrl}}"],
              "path": ["documents", "upload"]
            }
          }
        },
        {
          "name": "Upload Invalid PDF Content - 400",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Status is 400 Bad Request', () => pm.response.to.have.status(400));",
                "pm.test('Fake PDF content is rejected', () => {",
                "  const body = pm.response.json();",
                "  pm.expect(body.error).to.eql('VALIDATION_ERROR');",
                "  pm.expect(body.message).to.eql('The uploaded file content is not a valid PDF document.');",
                "});"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [{"key": "file", "type": "file", "src": ""}]
            },
            "url": {
              "raw": "{{baseUrl}}/documents/upload",
              "host": ["{{baseUrl}}"],
              "path": ["documents", "upload"]
            }
          }
        }
      ]
    }
  ]
}
